```css
/* =========================================
   GLOBAL RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #174A6E;
    --primary-dark: #0F3550;
    --accent: #E67E00;
    --accent-light: #FFF1DC;

    --text: #263746;
    --text-light: #526575;

    --light: #F5F8FA;
    --section-alt: #EAF1F5;
    --white: #FFFFFF;

    --border: #D5E0E7;
    --shadow: rgba(23, 74, 110, 0.12);

    --font-main: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}


/* =========================================
   HTML / BODY
========================================= */

html,
body,
#root {
    min-height: 100%;
    height: 100%;
}

body {
    font-family: var(--font-main);
    color: var(--text);
    background: var(--white);
    line-height: 1.6;
    min-height: 100vh;
}

.app-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.page-content {
    flex: 1;
}


/* =========================================
   CONTAINER
========================================= */

.container {
    width: min(1200px, calc(100% - 40px));
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}


/* =========================================
   SECTIONS
========================================= */

section {
    padding: 70px 0;
}

section:nth-of-type(even) {
    background: var(--section-alt);
}

section h2 {
    text-align: center;
    font-size: 2.2rem;
    margin-bottom: 40px;
    color: var(--primary-dark);
    font-weight: 700;
    letter-spacing: 0.3px;
}

section h2::after {
    content: '';
    display: block;
    width: 60px;
    height: 4px;
    background: var(--accent);
    margin: 12px auto 0;
    border-radius: 2px;
}


/* =========================================
   BUTTONS
========================================= */

.btn {
    display: inline-block;
    padding: 12px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.3s ease;
}

.btn-primary {
    background: var(--accent);
    color: var(--white);
}

.btn-primary:hover {
    background: var(--primary-dark);
    color: var(--white);
    border-color: var(--primary-dark);
}

.btn-secondary {
    background: transparent;
    color: var(--primary);
    border-color: var(--primary);
}

.btn-secondary:hover {
    background: var(--primary);
    color: var(--white);
}


/* =========================================
   FILTER BUTTONS
========================================= */

.filter-btn {
    padding: 9px 20px;
    background: var(--white);
    border: 2px solid var(--primary);
    color: var(--primary);
    border-radius: 25px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
}

.filter-btn:hover,
.filter-btn.active {
    background: var(--primary);
    color: var(--white);
}

.project-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
}

.projects-header {
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
}


/* =========================================
   ABOUT SECTION
========================================= */

.about-section {
    padding: 60px 0;
    background: var(--white);
}

.about-wrapper {
    display: grid;
    grid-template-columns: 280px 1fr;
    align-items: center;
    gap: 50px;
    max-width: 1000px;
    margin: 0 auto;
}

.about-image {
    display: flex;
    justify-content: center;
}

.about-image img {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    border: 6px solid var(--accent);
    box-shadow: 0 20px 40px var(--shadow);
}

.about-copy h1 {
    font-size: 2.75rem;
    color: var(--primary-dark);
    margin-bottom: 20px;
}

.about-copy p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-light);
}


/* =========================================
   PROJECTS
========================================= */

.projects-page {
    padding-top: 50px;
    padding-bottom: 70px;
}

.project-card {
    background: var(--white);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 8px 25px var(--shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 30px rgba(23, 74, 110, 0.18);
}

.project-card h3 {
    color: var(--primary-dark);
}

.project-card p {
    color: var(--text-light);
}


/* =========================================
   SKILLS
========================================= */

.skills-section {
    background: var(--section-alt);
}

.skill-card {
    background: var(--white);
    border: 1px solid var(--border);
    color: var(--text);
    border-radius: 12px;
    box-shadow: 0 6px 20px var(--shadow);
    transition: transform 0.3s ease;
}

.skill-card:hover {
    transform: translateY(-4px);
}

.skill-name {
    color: var(--primary-dark);
    font-weight: 700;
}

.skill-level {
    color: var(--accent);
    font-weight: 600;
}


/* =========================================
   TAGS
========================================= */

.tag {
    display: inline-block;
    background: var(--primary);
    color: var(--white);
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
}


/* =========================================
   GITHUB STATS
========================================= */

.github-stats {
    background: var(--light);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
}


/* =========================================
   CONTACT
========================================= */

.contact-section {
    background: var(--section-alt);
}

input,
textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: inherit;
    background: var(--white);
    color: var(--text);
}

input:focus,
textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(23, 74, 110, 0.12);
}

label {
    color: var(--primary-dark);
    font-weight: 600;
}

input::placeholder,
textarea::placeholder {
    color: #71808D;
}


/* =========================================
   FOOTER
========================================= */

.site-footer {
    background: var(--primary-dark);
    color: #E6EEF3;
}

.site-footer a {
    color: var(--white);
    text-decoration: none;
}

.site-footer a:hover {
    color: #FFB347;
}


/* =========================================
   THEME TOGGLE
========================================= */

.theme-toggle {
    background: var(--primary);
    color: var(--white);
    border: 1px solid var(--primary);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.theme-toggle:hover {
    background: var(--accent);
    border-color: var(--accent);
}


/* =========================================
   DARK MODE
========================================= */

body[data-theme="dark"] {
    --primary: #63B3ED;
    --primary-dark: #90CDF4;
    --accent: #FFB347;
    --accent-light: #3A2A18;

    --text: #F1F5F9;
    --text-light: #CBD5E1;

    --light: #172033;
    --section-alt: #1B2638;
    --white: #111827;

    --border: #334155;
    --shadow: rgba(0, 0, 0, 0.35);

    background: #0F172A;
    color: var(--text);
}


/* Dark sections */

body[data-theme="dark"] section {
    background: #0F172A;
}

body[data-theme="dark"] section:nth-of-type(even) {
    background: #1B2638;
}

body[data-theme="dark"] section h2 {
    color: #F8FAFC;
}


/* Dark navigation */

body[data-theme="dark"] .site-header,
body[data-theme="dark"] .navbar {
    background: #111827;
}

body[data-theme="dark"] .nav-links a {
    color: #F8FAFC;
}

body[data-theme="dark"] .nav-links a:hover,
body[data-theme="dark"] .nav-links a.active {
    color: var(--accent);
}

body[data-theme="dark"] .logo {
    color: #F8FAFC;
}


/* Dark hero */

body[data-theme="dark"] .hero-section {
    background: linear-gradient(
        135deg,
        #0F172A,
        #1E293B
    );
}

body[data-theme="dark"] .highlight {
    color: var(--accent);
}


/* Dark about */

body[data-theme="dark"] .about-section {
    background: #0F172A;
}

body[data-theme="dark"] .about-copy h1 {
    color: #F8FAFC;
}

body[data-theme="dark"] .about-copy p {
    color: #CBD5E1;
}


/* Dark skills */

body[data-theme="dark"] .skills-section {
    background: #1B2638;
}

body[data-theme="dark"] .skill-card,
body[data-theme="dark"] .skill-item {
    background: #243044;
    color: #F8FAFC;
    border-color: #475569;
}

body[data-theme="dark"] .skill-name {
    color: #F8FAFC;
}

body[data-theme="dark"] .skill-level {
    color: #FFB347;
}


/* Dark projects */

body[data-theme="dark"] .projects-section {
    background: #0F172A;
}

body[data-theme="dark"] .project-card {
    background: #1E293B;
    color: #F8FAFC;
    border-color: #475569;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
}

body[data-theme="dark"] .project-card h3 {
    color: #F8FAFC;
}

body[data-theme="dark"] .project-card p {
    color: #CBD5E1;
}


/* Dark tags */

body[data-theme="dark"] .tag {
    background: #25658A;
    color: #FFFFFF;
}


/* Dark GitHub stats */

body[data-theme="dark"] .github-stats {
    background: #1E293B;
    color: #F8FAFC;
    border-color: #475569;
}


/* Dark contact */

body[data-theme="dark"] .contact-section {
    background: #1B2638;
}

body[data-theme="dark"] input,
body[data-theme="dark"] textarea {
    background: #243044;
    color: #F8FAFC;
    border-color: #475569;
}

body[data-theme="dark"] input::placeholder,
body[data-theme="dark"] textarea::placeholder {
    color: #94A3B8;
}

body[data-theme="dark"] label {
    color: #F8FAFC;
}


/* Dark buttons */

body[data-theme="dark"] .btn-primary {
    background: #FFB347;
    color: #172033;
}

body[data-theme="dark"] .btn-primary:hover {
    background: #F8FAFC;
    color: #111827;
}

body[data-theme="dark"] .btn-secondary {
    border-color: #90CDF4;
    color: #90CDF4;
}

body[data-theme="dark"] .btn-secondary:hover {
    background: #90CDF4;
    color: #111827;
}


/* Dark footer */

body[data-theme="dark"] .site-footer {
    background: #080D16;
    color: #CBD5E1;
}

body[data-theme="dark"] .site-footer a {
    color: #F8FAFC;
}

body[data-theme="dark"] .site-footer a:hover {
    color: #FFB347;
}


/* Dark theme button */

body[data-theme="dark"] .theme-toggle {
    background: #243044;
    color: #F8FAFC;
    border-color: #475569;
}


/* =========================================
   RESPONSIVE PLACEMENT
========================================= */

@media (max-width: 860px) {

    .about-wrapper {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 25px;
    }

    .about-image {
        margin-bottom: 10px;
    }

    .about-image img {
        max-width: 230px;
    }

    .about-copy h1 {
        font-size: 2.3rem;
    }
}


@media (max-width: 768px) {

    section {
        padding: 55px 0;
    }

    section h2 {
        font-size: 1.9rem;
        margin-bottom: 30px;
    }

    .projects-header {
        align-items: center;
        text-align: center;
    }

    .project-filters {
        gap: 8px;
    }

    .filter-btn {
        padding: 8px 16px;
    }
}


@media (max-width: 480px) {

    .container {
        width: min(100% - 24px, 1200px);
        padding: 0 12px;
    }

    section {
        padding: 45px 0;
    }

    section h2 {
        font-size: 1.7rem;
    }

    .about-copy h1 {
        font-size: 2rem;
    }

    .about-copy p {
        font-size: 1rem;
    }

    .btn {
        padding: 10px 20px;
        font-size: 0.95rem;
    }
}
```
